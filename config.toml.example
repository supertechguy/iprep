# Reference only - prefer `iprep keys set <source>` to manage the real file,
# which lives at ~/.config/iprep/config.toml (owner-only permissions) and is
# never part of this repo.
#
# Env vars (VT_API_KEY, ABUSEIPDB_API_KEY, SHODAN_API_KEY, GREYNOISE_API_KEY,
# SPAMHAUS_DQS_KEY, OTX_API_KEY, THREATFOX_API_KEY, CROWDSEC_API_KEY,
# TALOS_COOKIE) always take precedence over the config file if both are set.

[keys]
virustotal = ""
abuseipdb = ""
shodan = ""
greynoise = ""
spamhaus_dqs = ""
otx = ""
threatfox = ""
crowdsec = ""
# Not an API key - a browser session cookie. See the README's
# "Why does Talos need a cookie?" section for how to get one.
talos = ""
